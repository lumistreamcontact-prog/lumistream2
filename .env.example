# PostgreSQL connection string.
#
# Free hosted option (recommended — zero install, same DB as production):
#   1. https://console.neon.tech  ->  Create a project  ->  copy the URL
#   2. Paste it here, adding `?sslmode=require` at the end.
#   Neon URLs already include `?sslmode=require`, so normally you paste as-is.
#
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/lumistream?sslmode=require"
#
# Local Docker option (default below): `docker compose up -d`
#   DATABASE_URL="postgresql://lumistream:lumistream@localhost:5432/lumistream?schema=public"

DATABASE_URL="postgresql://lumistream:lumistream@localhost:5432/lumistream?schema=public"

# Secret used to sign session JWTs and playback tokens (min 32 chars in production)
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Optional separate secret for short-lived stream playback tokens
STREAM_SECRET="change-me-stream-secret-at-least-32-chars"

# Public URL used for SEO / sitemap / canonical links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Bootstrap admin — created by `npm run db:seed` when no admin exists
ADMIN_EMAIL="admin@lumistream.local"
ADMIN_PASSWORD="ChangeMe!2024"
ADMIN_NAME="Platform Admin"

# Payment gateway: manual | stripe  (see lib/payments.ts)
PAYMENT_PROVIDER="manual"
PAYMENT_WEBHOOK_SECRET="change-me-webhook-secret"

# Toggle the demo content banner (demo streams are Apple/Mux test assets)
NEXT_PUBLIC_DEMO_MODE="true"

# Fallback WhatsApp number in full international format, digits only.
# Used only when the `whatsappNumber` row is missing from the database; the
# Admin > Settings screen (Admin > Settings > WhatsApp) is the source of truth.
NEXT_PUBLIC_WHATSAPP_NUMBER="212786172756"